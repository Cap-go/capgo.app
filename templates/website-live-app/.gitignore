# Web2App template: native ios/ and android/ sources are committed, including cap sync
# output such as capacitor.config.json, capacitor.plugins.json and
# ios/capacitor-cordova-ios-plugins. The web assets copied from www/ (public/) and
# android/capacitor-cordova-android-plugins are ignored by the nested .gitignore files
# and regenerated by `bunx cap sync` before packing.
node_modules/
dist/
*.zip
.DS_Store
*.log

# Android build outputs and local machine files
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/.kotlin/

# iOS build outputs
ios/App/build/
ios/App/output/
ios/App/Pods/
ios/DerivedData/
ios/App/DerivedData/
**/xcuserdata/
ios/App/CapApp-SPM/.build/
ios/App/CapApp-SPM/.swiftpm/config/registries.json
ios/App/CapApp-SPM/.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

    "deploy:cloudflare_env:plugin_jp:prod": "bunx wrangler secret bulk internal/cloudflare/.env.prod --config cloudflare_workers/plugin/wrangler.jsonc --env=prod_jp",
    "deploy:supabase:prod": "FUNCTIONS=$(bun scripts/supabase-cloud-functions.ts deploy-args) && test -n \"$FUNCTIONS\" && bunx supabase functions deploy $FUNCTIONS --project-ref xvwzpoazmxkqosrdewyv && for fn in $(bun scripts/supabase-cloud-functions.ts skip-list); do out=$(bunx supabase functions delete $fn --project-ref xvwzpoazmxkqosrdewyv 2>&1) || { echo \"$out\" | grep -qiE \"not found|does not exist|404|Function not found\" || { echo \"$out\" >&2; exit 1; }; }; done",
    "deploy:supabase:preprod": "FUNCTIONS=$(bun scripts/supabase-cloud-functions.ts deploy-args) && test -n \"$FUNCTIONS\" && bunx supabase functions deploy $FUNCTIONS --project-ref ibwjdnhknbkcqfbabwei && for fn in $(bun scripts/supabase-cloud-functions.ts skip-list); do out=$(bunx supabase functions delete $fn --project-ref ibwjdnhknbkcqfbabwei 2>&1) || { echo \"$out\" | grep -qiE \"not found|does not exist|404|Function not found\" || { echo \"$out\" >&2; exit 1; }; }; done",

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.declared-age-range</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:console.capgo.app</string>
		<string>applinks:console.dev.capgo.app</string>
		<string>applinks:console.preprod.capgo.app</string>
		<string>applinks:console.staging.capgo.app</string>
		<string>webcredentials:console.capgo.app</string>
	</array>
</dict>
</plist>

{
  "name": "capgo-r2-inventory",
  "main": "index.ts",
  "alias": {
    "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js"
  },
  "compatibility_date": "2026-04-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "env": {
    "prod": {
      "name": "capgo-r2-inventory-prod",
      "triggers": {
        "crons": ["* * * * *"]
      },
      "vars": {
        "INVENTORY_BUCKET": "capgo"
      },
      "r2_buckets": [
        {
          "binding": "ATTACHMENT_BUCKET",
          "bucket_name": "capgo"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_CAPGO_DIRECT_EU",
          "id": "ae1fe6178b564adc9fc9a71ccc769a35"
        },
        {
          "binding": "HYPERDRIVE_R2_INVENTORY",
          "id": "af73fa6a112b495f80e81718b153db76"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "CLEANUP_QUEUE",
            "queue": "capgo-r2-inventory-prod-cleanup"
          },
          {
            "binding": "REPAIR_QUEUE",
            "queue": "capgo-r2-inventory-prod-repair"
          },
          {
            "binding": "EVENT_DLQ",
            "queue": "capgo-r2-inventory-prod-dlq"
          },
          {
            "binding": "REPAIR_DLQ",
            "queue": "capgo-r2-inventory-prod-repair-dlq"
          },
          {
            "binding": "CLEANUP_DLQ",
            "queue": "capgo-r2-inventory-prod-cleanup-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "capgo-r2-inventory-prod",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_concurrency": 1,
            "max_retries": 4,
            "dead_letter_queue": "capgo-r2-inventory-prod-dlq"
          },
          {
            "queue": "capgo-r2-inventory-prod-repair",
            "max_batch_size": 10,
            "max_batch_timeout": 10,
            "max_concurrency": 1,
            "max_retries": 4,
            "dead_letter_queue": "capgo-r2-inventory-prod-repair-dlq"
          },
          {
            "queue": "capgo-r2-inventory-prod-cleanup",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_concurrency": 5,
            "max_retries": 2,
            "retry_delay": 30,
            "dead_letter_queue": "capgo-r2-inventory-prod-cleanup-dlq"
          }
        ]
      },
      "limits": {
        "cpu_ms": 300000
      }
    }
  }
}

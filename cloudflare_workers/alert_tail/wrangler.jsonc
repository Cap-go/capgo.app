{
  "name": "capgo_alert_tail",
  "compatibility_date": "2026-04-21",
  "main": "./index.ts",
  "workers_dev": false,
  "upload_source_maps": true,
  "env": {
    "prod": {
      "name": "capgo_alert_tail-prod",
      "vars": {
        "ENV_NAME": "capgo_alert_tail-prod",
        "ALERT_THROTTLE_WINDOW_SEC": "300",
        "ALERT_THROTTLE_SUMMARY_INTERVAL_SEC": "60"
      },
      "kv_namespaces": [
        {
          "binding": "ALERT_THROTTLE_STORE",
          "id": "7f3c8a2b9d1e4f50618293ab4c5d6e7f"
        }
      ],
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      }
    },
    "preprod": {
      "name": "capgo_alert_tail-preprod",
      "vars": {
        "ENV_NAME": "capgo_alert_tail-preprod",
        "ALERT_THROTTLE_WINDOW_SEC": "300",
        "ALERT_THROTTLE_SUMMARY_INTERVAL_SEC": "60"
      },
      "kv_namespaces": [
        {
          "binding": "ALERT_THROTTLE_STORE",
          "id": "8e4d9b3c0a2f5e61729384bc5d6e7f80"
        }
      ],
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      }
    },
    "alpha": {
      "name": "capgo_alert_tail-alpha",
      "vars": {
        "ENV_NAME": "capgo_alert_tail-alpha",
        "ALERT_THROTTLE_WINDOW_SEC": "300",
        "ALERT_THROTTLE_SUMMARY_INTERVAL_SEC": "60"
      },
      "kv_namespaces": [
        {
          "binding": "ALERT_THROTTLE_STORE",
          "id": "local-alert-throttle-store"
        }
      ],
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      }
    }
  }
}
